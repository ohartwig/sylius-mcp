{
    "name": "koh/sylius-mcp",
    "description": "MCP layer over the official sylius/mcp-server-plugin: project tool config + custom MCP tools for content-commerce.",
    "type": "sylius-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu"
        }
    ],
    "support": {
        "issues": "https://git.ole-hartwig.eu/ai-ready-platform/platform/sylius-mcp/-/issues",
        "source": "https://github.com/ole-hartwig/sylius-mcp"
    },
    "require": {
        "php": ">=8.5.10",
        "koh/sylius-agent-contracts": "^1.1",
        "sylius/sylius": "^2.2.9",
        "mcp/sdk": "^0.3.0",
        "sylius/mcp-server-plugin": "^0.2",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4"
    },
    "require-dev": {
        "moselwal/dev-sylius": "^1.0",
        "phpstan/phpstan": "^2.2.14",
        "phpunit/phpunit": "^13.3.3",
        "phpstan/extension-installer": "^1.4.3"
    },
    "autoload": {
        "psr-4": {
            "Koh\\SyliusMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\SyliusMcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "moselwal/*"
            ]
        },
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
